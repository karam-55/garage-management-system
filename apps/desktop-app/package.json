{
  "name": "@garage/desktop-app",
  "version": "1.0.0",
  "description": "Garage Management System - Desktop App",
  "main": "out/main/index.js",
  "packageManager": "pnpm@8.15.0",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "clean": "rm -rf dist out",
    "build:electron": "electron-vite build",
    "build:windows": "electron-vite build && electron-builder --win",
    "build:prod": "electron-vite build && electron-builder --win --publish never"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "axios": "^1.6.2",
    "form-data": "^4.0.0",
    "recharts": "^2.10.3",
    "date-fns": "^3.0.0",
    "zustand": "^4.4.7",
    "lucide-react": "^0.303.0",
    "react-router-dom": "^6.20.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.6.4",
    "electron-vite": "^2.0.0",
    "vite": "^5.0.11",
    "@types/node": "^20.10.6",
    "typescript": "^5.3.3",
    "@types/react": "^18.2.47",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "tailwindcss": "^3.4.0",
    "postcss": "^8.4.33",
    "autoprefixer": "^10.4.16"
  },
  "build": {
    "appId": "com.garage.management",
    "productName": "Garage Management",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/axios/**",
      "node_modules/form-data/**",
      "node_modules/follow-redirects/**"
    ],
    "win": {
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
