# Database (Render PostgreSQL)
DATABASE_URL=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Server
PORT=3001
NODE_ENV=production

# WhatsApp (Optional)
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=

# Email (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads
